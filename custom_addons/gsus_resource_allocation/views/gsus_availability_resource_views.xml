<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_availability_form_actual_resources" model="ir.ui.view">
        <field name="name">gsus.availability.form.actual.resources</field>
        <field name="model">gsus.availability</field>
        <field name="inherit_id" ref="gsus_resource_allocation.view_gsus_availability_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='available_count']" position="after">
                <field name="actual_resource_ids" widget="many2many_tags" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='worker_ids']" position="attributes">
                <attribute name="string">Legacy Workers</attribute>
            </xpath>
        </field>
    </record>
</odoo>
