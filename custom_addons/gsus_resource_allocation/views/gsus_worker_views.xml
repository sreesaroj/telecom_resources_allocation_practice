<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_worker_list" model="ir.ui.view"><field name="name">gsus.worker.list</field><field name="model">gsus.worker</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="name"/><field name="employee_code"/><field name="resource_type_id"/><field name="employment_type"/><field name="current_location_id"/><field name="mobile"/><field name="active"/></list></field></record>
    <record id="view_gsus_worker_form" model="ir.ui.view"><field name="name">gsus.worker.form</field><field name="model">gsus.worker</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="employee_code"/><field name="resource_type_id"/><field name="employment_type"/><field name="vendor_name" invisible="employment_type != 'temporary'"/></group><group><field name="mobile"/><field name="joining_date"/><field name="current_location_id"/><field name="active"/></group></group><notebook><page string="Assignment History"><field name="assignment_ids"><list><field name="name"/><field name="location_id"/><field name="start_date"/><field name="end_date"/><field name="shift"/><field name="state"/></list></field></page><page string="Notes"><field name="notes" placeholder="Operational notes..."/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_gsus_worker" model="ir.actions.act_window"><field name="name">Workers</field><field name="res_model">gsus.worker</field><field name="view_mode">list,form</field></record>
    <record id="view_gsus_resource_type_list" model="ir.ui.view"><field name="name">gsus.resource.type.list</field><field name="model">gsus.resource.type</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="category"/><field name="allow_temporary"/><field name="active"/></list></field></record>
    <record id="action_gsus_resource_type" model="ir.actions.act_window"><field name="name">Resource Types</field><field name="res_model">gsus.resource.type</field><field name="view_mode">list,form</field></record>
</odoo>
