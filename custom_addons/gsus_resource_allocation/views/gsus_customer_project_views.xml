<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_gsus" model="ir.ui.view"><field name="name">res.partner.form.gsus.telecom</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Telecom Access" groups="gsus_resource_allocation.group_gsus_manager"><group><field name="is_telecom_customer"/><field name="telecom_portal_enabled"/><field name="allowed_project_ids" widget="many2many_tags"/></group></page></xpath></field></record>
    <record id="view_project_form_gsus" model="ir.ui.view"><field name="name">project.project.form.gsus.telecom</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="customer_id"/><field name="rtm_manager_id"/><field name="telecom_project_type"/><field name="gsus_hour_format" widget="radio"/><field name="service_category_ids" widget="many2many_tags"/><field name="telecom_active"/></xpath></field></record>
    <record id="action_gsus_customers" model="ir.actions.act_window"><field name="name">Telecom Customers</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('is_telecom_customer','=',True)]</field><field name="context">{'default_is_telecom_customer': True}</field></record>
    <record id="action_gsus_projects" model="ir.actions.act_window"><field name="name">Telecom Projects</field><field name="res_model">project.project</field><field name="view_mode">list,kanban,form</field><field name="domain">[('telecom_active','=',True)]</field><field name="context">{'default_telecom_active': True}</field></record>
</odoo>
