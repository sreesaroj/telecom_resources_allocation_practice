<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_resource_list" model="ir.ui.view"><field name="name">gsus.resource.list</field><field name="model">gsus.resource</field><field name="arch" type="xml"><list decoration-success="status == 'available'" decoration-warning="status == 'reserved'" decoration-info="status in ('allocated','deployed')" decoration-danger="status in ('maintenance','expired','unavailable')"><field name="code"/><field name="name"/><field name="old_employee_id" optional="hide"/><field name="new_employee_id" optional="show"/><field name="resource_type_id"/><field name="project_id" invisible="1" column_invisible="1"/><field name="ownership"/><field name="vendor_id" optional="show"/><field name="shift_id"/><field name="status" widget="badge"/></list></field></record>
    <record id="view_gsus_resource_form" model="ir.ui.view"><field name="name">gsus.resource.form</field><field name="model">gsus.resource</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="old_employee_id" invisible="resource_source != 'person'"/><field name="new_employee_id" invisible="resource_source != 'person'"/><field name="resource_type_id"/><field name="project_id" invisible="1"/><field name="resource_source"/><field name="employee_id" invisible="resource_source != 'person'" required="resource_source == 'person'"/><field name="vehicle_id" invisible="resource_source != 'vehicle'" required="resource_source == 'vehicle'"/><field name="employment_type" invisible="resource_source != 'person'"/><field name="ownership"/><field name="vendor_id" invisible="ownership != 'vendor'" required="ownership == 'vendor'"/></group><group><field name="shift_id"/></group></group><group><group><field name="status"/><field name="available_from"/><field name="available_until"/></group><group><field name="reserved_request_id" readonly="1"/><field name="active"/></group></group><field name="remarks" placeholder="Availability, compliance or operational notes..."/></sheet><chatter/></form></field></record>
    <record id="view_gsus_resource_search" model="ir.ui.view"><field name="name">gsus.resource.search</field><field name="model">gsus.resource</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="customer_id"/><field name="project_id"/><field name="zone_id"/><field name="location_id"/><field name="resource_type_id"/><filter name="available" string="Available" domain="[('status','=','available')]"/><filter name="reserved" string="Reserved" domain="[('status','=','reserved')]"/><filter name="allocated" string="Allocated" domain="[('status','in',('allocated','deployed'))]"/><separator/><filter name="active_person" string="Active Persons" domain="[('active','=',True)]"/><filter name="inactive_person" string="Inactive Persons" domain="[('active','=',False)]" context="{'active_test': False}"/><group><filter name="group_status" string="Status" context="{'group_by':'status'}"/><filter name="group_type" string="Resource Type" context="{'group_by':'resource_type_id'}"/><filter name="group_location" string="FRT" context="{'group_by':'location_id'}"/></group></search></field></record>
    <record id="view_gsus_shift_list" model="ir.ui.view"><field name="name">gsus.shift.list</field><field name="model">gsus.shift</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="start_time" widget="float_time"/><field name="end_time" widget="float_time"/><field name="hours"/><field name="active"/></list></field></record>
    <record id="action_gsus_resource" model="ir.actions.act_window"><field name="name">Actual Resources</field><field name="res_model">gsus.resource</field><field name="view_mode">list,form</field><field name="context">{'search_default_available': 1}</field></record>
    <record id="action_gsus_shift" model="ir.actions.act_window"><field name="name">Shifts</field><field name="res_model">gsus.shift</field><field name="view_mode">list,form</field></record>
</odoo>
