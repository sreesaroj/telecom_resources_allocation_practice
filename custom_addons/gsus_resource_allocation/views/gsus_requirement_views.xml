<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_requirement_list" model="ir.ui.view"><field name="name">gsus.requirement.list</field><field name="model">gsus.requirement</field><field name="arch" type="xml"><list editable="bottom"><field name="customer_id" optional="hide"/><field name="project_id" optional="show"/><field name="zone_id"/><field name="location_id"/><field name="shift_id"/><field name="resource_type_id"/><field name="required_count" sum="Total Scope"/><field name="actual_available_qty" sum="Available"/><field name="reserved_qty" sum="Reserved"/><field name="allocated_qty" sum="Allocated"/><field name="actual_gap_qty" sum="Gap"/><field name="notes"/><field name="active"/></list></field></record>
