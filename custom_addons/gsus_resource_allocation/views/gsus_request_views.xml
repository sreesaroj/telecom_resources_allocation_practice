<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_request_list" model="ir.ui.view"><field name="name">gsus.resource.request.list</field><field name="model">gsus.resource.request</field><field name="arch" type="xml"><list decoration-info="state in ('submitted','review')" decoration-success="state in ('approved','allocated')" decoration-muted="state in ('completed','rejected','cancelled')"><field name="name"/><field name="request_date"/><field name="vendor_id"/><field name="customer_id"/><field name="project_id"/><field name="location_id"/><field name="shift_id"/><field name="required_from"/><field name="required_to"/><field name="resource_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_gsus_request_form" model="ir.ui.view"><field name="name">gsus.resource.request.form</field><field name="model">gsus.resource.request</field><field name="arch" type="xml"><form><header><button name="action_submit" string="Submit &amp; Reserve" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_review" string="Start Review" type="object" invisible="state != 'submitted'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" groups="gsus_resource_allocation.group_gsus_manager" invisible="state not in ('submitted','review')"/><button name="action_allocate" string="Allocate" type="object" class="btn-primary" groups="gsus_resource_allocation.group_gsus_manager" invisible="state != 'approved'"/><button name="action_reject" string="Reject" type="object" groups="gsus_resource_allocation.group_gsus_manager" invisible="state not in ('submitted','review','approved')"/><button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','submitted','review')"/><button name="action_complete" string="Complete &amp; Release" type="object" class="btn-primary" invisible="state != 'allocated'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,review,approved,allocated,completed"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="vendor_id" readonly="state != 'draft'"/><field name="customer_id" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="zone_id" readonly="state != 'draft'"/><field name="location_id" readonly="state != 'draft'"/></group><group><field name="shift_id" readonly="state != 'draft'"/><field name="required_from" readonly="state != 'draft'"/><field name="required_to" readonly="state != 'draft'"/><field name="request_date"/><field name="approved_by"/><field name="approved_date"/></group></group><field name="request_line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="resource_id"/><field name="resource_type_id"/><field name="quantity"/><field name="line_state" widget="badge"/><field name="remarks"/></list></field><field name="notes" placeholder="Vendor request notes..."/></sheet><chatter/></form></field></record>
    <record id="view_gsus_request_search" model="ir.ui.view"><field name="name">gsus.resource.request.search</field><field name="model">gsus.resource.request</field><field name="arch" type="xml"><search><field name="name"/><field name="vendor_id"/><field name="customer_id"/><field name="project_id"/><field name="location_id"/><filter name="open" string="Open" domain="[('state','in',('submitted','review','approved','allocated'))]"/><group><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/><filter name="group_project" string="Project" context="{'group_by':'project_id'}"/></group></search></field></record>
    <record id="action_gsus_request" model="ir.actions.act_window"><field name="name">Vendor Requests</field><field name="res_model">gsus.resource.request</field><field name="view_mode">list,form</field></record>
</odoo>
