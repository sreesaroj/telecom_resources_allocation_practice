<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_gap_list" model="ir.ui.view"><field name="name">gsus.gap.list</field><field name="model">gsus.gap</field><field name="arch" type="xml"><list decoration-danger="state != 'resolved' and aging_days &gt;= 30" decoration-warning="state != 'resolved' and aging_days &gt;= 15" decoration-success="state == 'resolved'"><field name="name"/><field name="customer_id" optional="hide"/><field name="project_id" optional="show"/><field name="zone_id"/><field name="location_id"/><field name="shift_id"/><field name="resource_type_id"/><field name="worker_id" optional="show"/><field name="gap_count" sum="Total Gap"/><field name="gap_start_date"/><field name="aging_days"/><field name="expected_closure_date"/><field name="responsible_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_gsus_gap_form" model="ir.ui.view"><field name="name">gsus.gap.form</field><field name="model">gsus.gap</field><field name="arch" type="xml"><form><header><button name="action_plan" string="Plan Replacement" type="object" class="btn-primary" invisible="state != 'open'"/><button name="action_temporary" string="Mark Temporarily Filled" type="object" invisible="state == 'resolved'"/><button name="action_resolve" string="Resolve" type="object" class="btn-primary" invisible="state == 'resolved'"/><field name="state" widget="statusbar" statusbar_visible="open,planned,temporary,resolved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="location_id"/><field name="zone_id"/><field name="project_id"/><field name="customer_id"/><field name="shift_id"/><field name="resource_type_id"/><field name="gap_count"/></group><group><field name="worker_id"/><field name="replacement_worker_id"/><field name="responsible_id"/><field name="gap_start_date"/><field name="aging_days"/><field name="expected_closure_date"/></group></group><group><field name="reason"/><field name="action_taken"/></group></sheet><chatter/></form></field></record>
    <record id="view_gsus_gap_search" model="ir.ui.view"><field name="name">gsus.gap.search</field><field name="model">gsus.gap</field><field name="arch" type="xml"><search><field name="zone_id"/><field name="location_id"/><field name="resource_type_id"/><filter name="open" string="Open Gaps" domain="[('state','!=','resolved')]"/><filter name="aging_15" string="15+ Days" domain="[('aging_days','&gt;=',15),('state','!=','resolved')]"/><filter name="aging_30" string="30+ Days" domain="[('aging_days','&gt;=',30),('state','!=','resolved')]"/><group><filter name="group_zone" string="Zone" context="{'group_by':'zone_id'}"/><filter name="group_location" string="FRT" context="{'group_by':'location_id'}"/><filter name="group_resource" string="Resource" context="{'group_by':'resource_type_id'}"/></group></search></field></record>
    <record id="view_gsus_gap_graph" model="ir.ui.view"><field name="name">gsus.gap.graph</field><field name="model">gsus.gap</field><field name="arch" type="xml"><graph string="Resource Gaps" type="bar"><field name="zone_id"/><field name="resource_type_id"/><field name="gap_count" type="measure"/></graph></field></record>
    <record id="action_gsus_gap" model="ir.actions.act_window"><field name="name">Resource Gaps</field><field name="res_model">gsus.gap</field><field name="view_mode">list,graph,pivot,form</field><field name="context">{'search_default_open': 1}</field></record>
</odoo>
