<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_assignment_list" model="ir.ui.view"><field name="name">gsus.assignment.list</field><field name="model">gsus.assignment</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'ended'"><field name="name"/><field name="worker_id"/><field name="resource_type_id"/><field name="zone_id"/><field name="location_id"/><field name="shift"/><field name="start_date"/><field name="end_date"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_gsus_assignment_form" model="ir.ui.view"><field name="name">gsus.assignment.form</field><field name="model">gsus.assignment</field><field name="arch" type="xml"><form><header><button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_end" string="End Assignment" type="object" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,ended"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="worker_id"/><field name="resource_type_id"/><field name="location_id"/><field name="zone_id"/></group><group><field name="shift"/><field name="start_date"/><field name="end_date"/><field name="notes"/></group></group></sheet><chatter/></form></field></record>
    <record id="action_gsus_assignment" model="ir.actions.act_window"><field name="name">Assignments</field><field name="res_model">gsus.assignment</field><field name="view_mode">list,form</field><field name="context">{'search_default_active': 1}</field></record>
</odoo>
