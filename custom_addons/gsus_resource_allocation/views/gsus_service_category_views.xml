<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_service_category_list" model="ir.ui.view"><field name="name">gsus.service.category.list</field><field name="model">gsus.service.category</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="icon"/><field name="resource_type_ids" widget="many2many_tags"/><field name="active"/></list></field></record>
