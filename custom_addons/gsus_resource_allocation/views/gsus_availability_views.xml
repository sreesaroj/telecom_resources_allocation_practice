<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_availability_list" model="ir.ui.view"><field name="name">gsus.availability.list</field><field name="model">gsus.availability</field><field name="arch" type="xml"><list decoration-success="total_gap == 0" decoration-danger="total_gap &gt; 0"><field name="name"/><field name="availability_date"/><field name="shift"/><field name="zone_id"/><field name="location_id"/><field name="total_required" sum="Scope"/><field name="total_available" sum="Available"/><field name="total_gap" sum="Gap"/><field name="availability_percent" widget="percentage"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_gsus_availability_form" model="ir.ui.view"><field name="name">gsus.availability.form</field><field name="model">gsus.availability</field><field name="arch" type="xml"><form><header><button name="action_load_scope" string="Load FRT Scope" type="object" invisible="state != 'draft'"/><button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" groups="gsus_resource_allocation.group_gsus_manager" invisible="state != 'submitted'"/><button name="action_reset_draft" string="Reset to Draft" type="object" groups="gsus_resource_allocation.group_gsus_manager" invisible="state == 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="availability_date" readonly="state != 'draft'"/><field name="shift" readonly="state != 'draft'"/><field name="location_id" readonly="state != 'draft'"/><field name="zone_id"/></group><group><field name="total_required"/><field name="total_available"/><field name="total_gap"/><field name="availability_percent" widget="progressbar"/></group></group><field name="line_ids" readonly="state != 'draft'"><list editable="bottom" decoration-danger="gap_count &gt; 0" decoration-success="gap_count == 0"><field name="resource_type_id"/><field name="required_count"/><field name="available_count"/><field name="temporary_count"/><field name="alternate_count"/><field name="gap_count"/><field name="excess_count" optional="hide"/><field name="worker_ids" widget="many2many_tags" optional="hide"/><field name="absent_worker_ids" widget="many2many_tags" optional="hide"/><field name="remarks"/></list></field><group><field name="notes" placeholder="Shift summary and operational notes..."/></group></sheet><chatter/></form></field></record>
    <record id="view_gsus_availability_search" model="ir.ui.view"><field name="name">gsus.availability.search</field><field name="model">gsus.availability</field><field name="arch" type="xml"><search><field name="availability_date"/><field name="zone_id"/><field name="location_id"/><filter name="with_gap" string="With Gap" domain="[('total_gap','&gt;',0)]"/><group><filter name="group_zone" string="Zone" context="{'group_by':'zone_id'}"/><filter name="group_location" string="FRT" context="{'group_by':'location_id'}"/><filter name="group_date" string="Date" context="{'group_by':'availability_date'}"/></group></search></field></record>
    <record id="view_gsus_availability_graph" model="ir.ui.view"><field name="name">gsus.availability.graph</field><field name="model">gsus.availability</field><field name="arch" type="xml"><graph string="Resource Availability" type="bar"><field name="zone_id"/><field name="total_required" type="measure"/><field name="total_available" type="measure"/><field name="total_gap" type="measure"/></graph></field></record>
    <record id="action_gsus_availability" model="ir.actions.act_window"><field name="name">Daily Availability</field><field name="res_model">gsus.availability</field><field name="view_mode">list,graph,pivot,form</field></record>
</odoo>
