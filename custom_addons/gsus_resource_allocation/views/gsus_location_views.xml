<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_location_list" model="ir.ui.view"><field name="name">gsus.location.list</field><field name="model">gsus.location</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="circle"/><field name="customer_id"/><field name="project_id"/><field name="zone_id"/><field name="district_id"/><field name="frt_hours"/><field name="responsible_id"/><field name="rtm_manager_id"/><field name="portal_user_ids" widget="many2many_tags"/><field name="active"/></list></field></record>
    <record id="view_gsus_location_form" model="ir.ui.view"><field name="name">gsus.location.form</field><field name="model">gsus.location</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name" string="FRT Location"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="circle"/><field name="zone_id"/><field name="district_id"/><field name="project_id"/><field name="customer_id"/></group><group><field name="frt_hours"/><field name="monthly_km_scope"/><field name="driver_resource_id" options="{'no_create': True, 'no_create_edit': True}"/><field name="responsible_id"/><field name="rtm_manager_id"/><field name="portal_user_ids" widget="many2many_tags"/><field name="active"/></group></group><group><field name="address"/><field name="latitude"/><field name="longitude"/></group><notebook><page string="Resource Scope"><field name="requirement_ids"><list editable="bottom"><field name="resource_type_id"/><field name="shift_id"/><field name="required_count"/><field name="actual_available_qty"/><field name="reserved_qty"/><field name="allocated_qty"/><field name="actual_gap_qty"/><field name="notes"/></list></field></page><page string="Assignments"><field name="assignment_ids" readonly="1"><list><field name="name"/><field name="worker_id"/><field name="resource_type_id"/><field name="shift"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_gsus_location" model="ir.actions.act_window"><field name="name">FRT Locations</field><field name="res_model">gsus.location</field><field name="view_mode">list,form</field></record>
</odoo>
