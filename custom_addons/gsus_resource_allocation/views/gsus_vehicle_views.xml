<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_vehicle_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.gsus.list</field><field name="model">fleet.vehicle</field>
        <field name="arch" type="xml"><list decoration-success="gsus_status == 'available'" decoration-danger="gsus_status in ('expired','maintenance','unavailable')"><field name="license_plate"/><field name="model_id"/><field name="gsus_vehicle_type"/><field name="gsus_vendor_id" optional="show"/><field name="driver_id" optional="show"/><field name="insurance_expiry_date"/><field name="fc_date"/><field name="gsus_status" widget="badge"/></list></field>
    </record>
    <record id="view_gsus_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.gsus.form</field><field name="model">fleet.vehicle</field><field name="priority">1</field>
        <field name="arch" type="xml"><form><sheet><field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/><div class="oe_title"><label for="license_plate"/><h1><field name="license_plate" placeholder="TN 01 AB 1234"/></h1></div><group><group string="Vehicle Details"><field name="model_id"/><field name="gsus_vehicle_type"/><field name="gsus_vendor_id" invisible="gsus_vehicle_type != 'vendor'" required="gsus_vehicle_type == 'vendor'" options="{'no_quick_create': False, 'no_create_edit': False}"/><field name="gsus_driver_contact_ids" invisible="1"/><field name="driver_id" domain="[('id', 'in', gsus_driver_contact_ids)]"/><field name="vin_sn"/><field name="acquisition_date"/><field name="odometer"/><field name="odometer_unit"/></group><group string="Availability"><field name="gsus_status"/></group></group><group string="Insurance &amp; Compliance"><group><field name="insurance_policy_no"/><field name="insurance_company"/><field name="insurance_expiry_date"/><field name="fc_date"/><field name="permit_expiry_date"/><field name="pollution_expiry_date"/></group><group><field name="insurance_document_ids" widget="many2many_binary"/><field name="vehicle_document_ids" widget="many2many_binary"/></group></group></sheet><chatter/></form></field>
    </record>
    <record id="action_gsus_vehicle_master" model="ir.actions.act_window"><field name="name">Vehicle Master</field><field name="res_model">fleet.vehicle</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_gsus_vehicle_list')}),(0,0,{'view_mode':'form','view_id':ref('view_gsus_vehicle_form')})]"/></record>
</odoo>
