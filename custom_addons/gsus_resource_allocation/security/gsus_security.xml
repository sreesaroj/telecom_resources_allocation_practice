<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gsus" model="ir.module.category">
        <field name="name">GSUS Resources</field><field name="sequence">35</field>
    </record>
    <record id="privilege_gsus" model="res.groups.privilege">
        <field name="name">GSUS Resources</field><field name="sequence">35</field><field name="category_id" ref="module_category_gsus"/>
    </record>
    <record id="group_gsus_user" model="res.groups">
        <field name="name">Operations User</field><field name="sequence">10</field><field name="privilege_id" ref="privilege_gsus"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_gsus_manager" model="res.groups">
        <field name="name">Operations Manager</field><field name="sequence">20</field><field name="privilege_id" ref="privilege_gsus"/>
        <field name="implied_ids" eval="[(4, ref('group_gsus_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_gsus_rtm_manager" model="res.groups">
        <field name="name">RTM Manager</field><field name="sequence">15</field><field name="privilege_id" ref="privilege_gsus"/>
        <field name="implied_ids" eval="[(4, ref('group_gsus_user'))]"/>
        <field name="comment">Restricted operational access: assigned project or assigned FRT Location only.</field>
    </record>

    <!-- RTM users can only work on the project or FRT Location assigned to them. -->
    <record id="rule_gsus_rtm_project" model="ir.rule">
        <field name="name">RTM: assigned project or FRT project only</field><field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">['|', ('rtm_manager_id', '=', user.id), ('gsus_location_ids.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_project_write" model="ir.rule">
        <field name="name">RTM: project manager can edit assigned project</field><field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="False"/><field name="perm_write" eval="True"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_zone" model="ir.rule">
        <field name="name">RTM: assigned project or FRT zones only</field><field name="model_id" ref="model_gsus_zone"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('location_ids.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_location" model="ir.rule">
        <field name="name">RTM: assigned project or FRT locations only</field><field name="model_id" ref="model_gsus_location"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_frt_availability" model="ir.rule">
        <field name="name">RTM: assigned project or FRT availability only</field><field name="model_id" ref="model_gsus_frt_availability"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('location_id.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_frt_availability_line" model="ir.rule">
        <field name="name">RTM: assigned FRT availability lines only</field><field name="model_id" ref="model_gsus_frt_availability_line"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('location_id.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_frt_vehicle_km" model="ir.rule">
        <field name="name">RTM: assigned FRT vehicle KM only</field><field name="model_id" ref="model_gsus_frt_vehicle_km"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('location_id.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_frt_alternate" model="ir.rule">
        <field name="name">RTM: assigned FRT alternate allocations only</field><field name="model_id" ref="model_gsus_frt_alternate_allocation"/>
        <field name="domain_force">['|', ('project_id.rtm_manager_id', '=', user.id), ('location_id.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_rtm_frt_history" model="ir.rule">
        <field name="name">RTM: assigned FRT history only</field><field name="model_id" ref="model_gsus_frt_availability_history"/>
        <field name="domain_force">['|', ('availability_id.project_id.rtm_manager_id', '=', user.id), ('availability_id.location_id.rtm_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gsus_rtm_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_location_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT locations only</field><field name="model_id" ref="model_gsus_location"/>
        <field name="domain_force">['|', ('portal_user_ids', 'in', user.id), ('project_id', 'in', user.partner_id.allowed_project_ids.ids)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_requirement_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT requirements</field><field name="model_id" ref="model_gsus_requirement"/>
        <field name="domain_force">['|', ('location_id.portal_user_ids', 'in', user.id), ('project_id', 'in', user.partner_id.allowed_project_ids.ids)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_assignment_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT assignments</field><field name="model_id" ref="model_gsus_assignment"/>
        <field name="domain_force">[('location_id.portal_user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_availability_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT availability</field><field name="model_id" ref="model_gsus_availability"/>
        <field name="domain_force">[('location_id.portal_user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_gap_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT gaps</field><field name="model_id" ref="model_gsus_gap"/>
        <field name="domain_force">[('location_id.portal_user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_availability_line_portal" model="ir.rule">
        <field name="name">Portal: assigned FRT availability lines</field><field name="model_id" ref="model_gsus_availability_line"/>
        <field name="domain_force">[('availability_id.location_id.portal_user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_resource_portal" model="ir.rule">
        <field name="name">Portal: resources in allowed projects</field><field name="model_id" ref="model_gsus_resource"/>
        <field name="domain_force">[('project_id', 'in', user.partner_id.allowed_project_ids.ids)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_project_portal" model="ir.rule">
        <field name="name">Portal: explicitly allowed telecom projects</field><field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('id', 'in', user.partner_id.allowed_project_ids.ids)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_zone_portal" model="ir.rule">
        <field name="name">Portal: zones in allowed projects or assigned FRT</field><field name="model_id" ref="model_gsus_zone"/>
        <field name="domain_force">['|', ('project_id', 'in', user.partner_id.allowed_project_ids.ids), ('location_ids.portal_user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_district_portal" model="ir.rule">
        <field name="name">Portal: districts in allowed projects</field><field name="model_id" ref="model_gsus_district"/>
        <field name="domain_force">[('project_id', 'in', user.partner_id.allowed_project_ids.ids)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_request_portal" model="ir.rule">
        <field name="name">Portal: own resource requests</field><field name="model_id" ref="model_gsus_resource_request"/>
        <field name="domain_force">[('vendor_id', '=', user.partner_id.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_gsus_request_line_portal" model="ir.rule">
        <field name="name">Portal: own resource request lines</field><field name="model_id" ref="model_gsus_resource_request_line"/>
        <field name="domain_force">[('request_id.vendor_id', '=', user.partner_id.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
